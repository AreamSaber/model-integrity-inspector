{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mii:dataset:detector-input:1.0.0",
  "title": "Detector-visible observation only; no oracle metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "samples"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"$ref": "#/$defs/id"},
    "samples": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/sample"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "count": {"type": "integer", "minimum": 0},
    "message": {
      "type": "object", "additionalProperties": false, "required": ["role", "content"],
      "properties": {"role": {"type": "string"}, "content": {"type": "string"}}
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "messages", "max_output_tokens", "stream"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "messages": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/message"}},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "stream": {"type": "boolean"}, "temperature": {"type": "number"}, "seed": {"type": "integer"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["http_status", "content", "model_reported", "finish_reason", "duration_ms"],
      "properties": {
        "http_status": {"oneOf": [{"const": 0}, {"type": "integer", "minimum": 100, "maximum": 599}]},
        "content": {"type": "string"}, "model_reported": {"type": "string"}, "finish_reason": {"type": "string"},
        "prompt_tokens": {"$ref": "#/$defs/count"}, "completion_tokens": {"$ref": "#/$defs/count"},
        "total_tokens": {"$ref": "#/$defs/count"}, "reasoning_tokens": {"$ref": "#/$defs/count"},
        "stream_terminated": {"type": "boolean"}, "transport_error": {"type": "string"}, "duration_ms": {"$ref": "#/$defs/count"}
      }
    },
    "tokenizer": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "quality"],
      "properties": {
        "id": {"type": "string"}, "version": {"type": "string"},
        "quality": {"enum": ["exact", "compatible", "heuristic", "unavailable"]},
        "local_token_count": {"$ref": "#/$defs/count"}
      },
      "allOf": [{
        "if": {"properties": {"quality": {"const": "unavailable"}}},
        "then": {"not": {"required": ["local_token_count"]}},
        "else": {"required": ["local_token_count"], "properties": {"id": {"minLength": 1}, "version": {"minLength": 1}}}
      }]
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "probe_family", "language", "request", "response", "tokenizer"],
      "properties": {
        "sample_id": {"$ref": "#/$defs/id"}, "probe_family": {"type": "string", "minLength": 1}, "language": {"type": "string", "minLength": 1},
        "request": {"$ref": "#/$defs/request"}, "response": {"$ref": "#/$defs/response"}, "tokenizer": {"$ref": "#/$defs/tokenizer"}
      }
    }
  }
}
