{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mii:dataset:manifest:1.0.0",
  "title": "Controller-only dataset manifest, never mount in blind detector",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_version": {"$ref": "#/$defs/id"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "split", "lineage_id", "input_sha256", "coverage"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "split": {"enum": ["development", "calibration", "regression", "blind", "gray"]},
        "lineage_id": {"$ref": "#/$defs/id"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/condition"}}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "condition": {"enum": ["normal", "fixed_cap", "probabilistic_cap", "hidden_instruction", "stream_mutation", "usage_forgery", "natural_short_answer", "safety_refusal", "unknown_tokenizer", "reasoning_model", "high_network_error"]}
  }
}
